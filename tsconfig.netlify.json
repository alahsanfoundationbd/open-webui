{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"types": ["node", "vite/client", "@netlify/functions"]
	},
	"include": [
		"netlify-web/**/*.ts",
		"netlify/**/*.mts",
		"netlify/lib/**/*.ts",
		"db/**/*.ts",
		"drizzle.config.ts"
	]
}
